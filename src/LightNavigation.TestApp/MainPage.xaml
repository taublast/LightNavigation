<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LightNavigation.TestApp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="LightNavigation"
    BackgroundColor="#232323">

    <ScrollView>

        <VerticalStackLayout Padding="30,20" Spacing="15">

            <!--  Header  -->
            <Border
                Margin="0,0,0,20"
                Padding="20"
                BackgroundColor="#6200EE"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="5">
                    <Label
                        FontAttributes="Bold"
                        FontSize="24"
                        HorizontalOptions="Center"
                        Text="🚀 LightNavigation Test App"
                        TextColor="White" />
                    <Label
                        FontSize="14"
                        HorizontalOptions="Center"
                        Text="Test smooth navigation without black flash"
                        TextColor="#E0E0E0" />
                </VerticalStackLayout>
            </Border>

            <!--  Transition Selector  -->
            <Label
                Margin="0,10,0,5"
                FontAttributes="Bold"
                FontSize="18"
                Text="Transition Settings" />

            <Border
                Padding="15"
                BackgroundColor="White"
                Stroke="#E0E0E0"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">

                    <!--  Per-Page Transition  -->
                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="Per-Page Transition Override:" />
                    <Label
                        x:Name="CurrentTransitionLabel"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Default"
                        TextColor="#6200EE" />

                    <Picker
                        x:Name="TransitionPicker"
                        Title="Choose Per-Page Transition"
                        FontSize="14"
                        SelectedIndexChanged="OnTransitionChanged"
                        TextColor="Red">
                        <Picker.Items>
                            <x:String>Default</x:String>
                            <x:String>None</x:String>
                            <x:String>SlideFromRight</x:String>
                            <x:String>SlideFromLeft</x:String>
                            <x:String>SlideFromBottom</x:String>
                            <x:String>SlideFromTop</x:String>
                            <x:String>ParallaxSlideFromRight</x:String>
                            <x:String>ParallaxSlideFromLeft</x:String>
                            <x:String>Fade</x:String>
                            <x:String>ZoomIn</x:String>
                            <x:String>ZoomOut</x:String>
                            <x:String>WhirlIn</x:String>
                            <x:String>WhirlIn3</x:String>
                        </Picker.Items>
                    </Picker>

                    <BoxView
                        Margin="0,10"
                        HeightRequest="1"
                        Color="#E0E0E0" />

                    <!--  Global Default Transition  -->
                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="Global Default Transition:" />

                    <Label
                        x:Name="GlobalDefaultLabel"
                        Margin="0,0,0,5"
                        FontSize="12"
                        Text="Default (Platform Native)"
                        TextColor="#666" />

                    <Picker
                        x:Name="DefaultTransitionPicker"
                        Title="Set Global Default"
                        FontSize="14"
                        SelectedIndexChanged="OnDefaultTransitionChanged"
                        TextColor="Red">

                        <Picker.Items>
                            <x:String>Default</x:String>
                            <x:String>None</x:String>
                            <x:String>SlideFromRight</x:String>
                            <x:String>SlideFromLeft</x:String>
                            <x:String>SlideFromBottom</x:String>
                            <x:String>SlideFromTop</x:String>
                            <x:String>ParallaxSlideFromRight</x:String>
                            <x:String>ParallaxSlideFromLeft</x:String>
                            <x:String>Fade</x:String>
                            <x:String>ZoomIn</x:String>
                            <x:String>ZoomOut</x:String>
                            <x:String>WhirlIn</x:String>
                            <x:String>WhirlIn3</x:String>
                        </Picker.Items>
                    </Picker>




                </VerticalStackLayout>
            </Border>

            <!--  Navigation Tests Section  -->
            <Label
                Margin="0,10,0,5"
                FontAttributes="Bold"
                FontSize="18"
                Text="Basic Navigation Tests" />

            <Border
                Padding="0"
                BackgroundColor="White"
                Stroke="#E0E0E0"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="0">

                    <Button
                        Margin="10"
                        BackgroundColor="#6200EE"
                        Clicked="OnNavigateDetailClicked"
                        CornerRadius="8"
                        HeightRequest="50"
                        Text="Navigate to Detail Page (Animated)"
                        TextColor="White" />

                    <BoxView
                        Margin="10,0"
                        HeightRequest="1"
                        Color="#E0E0E0" />

                    <Button
                        Margin="10"
                        BackgroundColor="#03DAC6"
                        Clicked="OnNavigateDetailNoAnimClicked"
                        CornerRadius="8"
                        HeightRequest="50"
                        Text="Navigate to Detail Page (No Animation)"
                        TextColor="#000000" />

                    <BoxView
                        Margin="10,0"
                        HeightRequest="1"
                        Color="#E0E0E0" />

                    <Button
                        Margin="10"
                        BackgroundColor="#018786"
                        Clicked="OnNavigateAwareClicked"
                        CornerRadius="8"
                        HeightRequest="50"
                        Text="Navigate to INavigationAware Page"
                        TextColor="White" />

                    <BoxView
                        Margin="10,0"
                        HeightRequest="1"
                        Color="#E0E0E0" />

                    <Button
                        Margin="10"
                        BackgroundColor="#B00020"
                        Clicked="OnPushModalClicked"
                        CornerRadius="8"
                        HeightRequest="50"
                        Text="Push Modal (Standard MAUI)"
                        TextColor="White" />

                </VerticalStackLayout>
            </Border>

            <!--  Stress Tests  -->
            <Label
                Margin="0,20,0,5"
                FontAttributes="Bold"
                FontSize="18"
                Text="Stress Tests" />

            <Border
                Padding="0"
                BackgroundColor="White"
                Stroke="#E0E0E0"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="0">

                    <Button
                        Margin="10"
                        BackgroundColor="#FF2200"
                        Clicked="OnPlayAllTransitionsClicked"
                        CornerRadius="8"
                        HeightRequest="50"
                        Text="ALL Transitions Demo"
                        TextColor="White" />

                    <BoxView
                        Margin="10,0"
                        HeightRequest="1"
                        Color="#E0E0E0" />

                    <Button
                        Margin="10"
                        BackgroundColor="#FF6F00"
                        Clicked="OnRapidPushPopClicked"
                        CornerRadius="8"
                        HeightRequest="50"
                        Text="Rapid Push/Pop (10 cycles)"
                        TextColor="White" />

                    <BoxView
                        Margin="10,0"
                        HeightRequest="1"
                        Color="#E0E0E0" />

                    <Button
                        Margin="10"
                        BackgroundColor="#F57F17"
                        Clicked="OnRandomAnimationPushPopClicked"
                        CornerRadius="8"
                        HeightRequest="50"
                        Text="RANDOM Transitions (20 cycles)"
                        TextColor="White" />

                    <BoxView
                        Margin="10,0"
                        HeightRequest="1"
                        Color="#E0E0E0" />

                    <Button
                        Margin="10"
                        BackgroundColor="#E65100"
                        Clicked="OnRapidPopToRootClicked"
                        CornerRadius="8"
                        HeightRequest="50"
                        Text="Deep Stack + Rapid PopToRoot (5 cycles)"
                        TextColor="White" />

                    <!--<BoxView HeightRequest="1" Color="#E0E0E0" Margin="10,0" />

            <Button Text="Mixed Animation Torture Test (30 ops)"
                    Clicked="OnMixedAnimationTortureClicked"
                    BackgroundColor="#BF360C"
                    TextColor="White"
                    Margin="10"
                    CornerRadius="8"
                    HeightRequest="50" />-->

                </VerticalStackLayout>
            </Border>


            <!--  Multi-Level Navigation Tests  -->
            <Label
                Margin="0,20,0,5"
                FontAttributes="Bold"
                FontSize="18"
                Text="Multi-Level Navigation Tests" />

            <Border
                Padding="0"
                BackgroundColor="White"
                Stroke="#E0E0E0"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="0">

                    <Button
                        Margin="10"
                        BackgroundColor="#BB86FC"
                        Clicked="OnPushThreePagesClicked"
                        CornerRadius="8"
                        HeightRequest="50"
                        Text="Push 3 Pages in Sequence"
                        TextColor="#000000" />

                    <BoxView
                        Margin="10,0"
                        HeightRequest="1"
                        Color="#E0E0E0" />

                    <Button
                        Margin="10"
                        BackgroundColor="#CF6679"
                        Clicked="OnPushFiveRapidlyClicked"
                        CornerRadius="8"
                        HeightRequest="50"
                        Text="Push 5 Pages Rapidly"
                        TextColor="White" />

                    <BoxView
                        Margin="10,0"
                        HeightRequest="1"
                        Color="#E0E0E0" />

                    <Button
                        Margin="10"
                        BackgroundColor="#4CAF50"
                        Clicked="OnPopToRootAnimatedClicked"
                        CornerRadius="8"
                        HeightRequest="50"
                        Text="PopToRoot (Animated)"
                        TextColor="White" />

                    <BoxView
                        Margin="10,0"
                        HeightRequest="1"
                        Color="#E0E0E0" />

                    <Button
                        Margin="10"
                        BackgroundColor="#8BC34A"
                        Clicked="OnPopToRootNoAnimClicked"
                        CornerRadius="8"
                        HeightRequest="50"
                        Text="PopToRoot (No Animation)"
                        TextColor="#000000" />

                </VerticalStackLayout>
            </Border>


            <!--  Stack Info  -->
            <Label
                Margin="0,20,0,5"
                FontAttributes="Bold"
                FontSize="18"
                Text="Navigation Stack Info" />

            <Border
                Padding="15"
                BackgroundColor="White"
                Stroke="#E0E0E0"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="5">
                    <Label
                        x:Name="StackCountLabel"
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="Stack Count: 1" />
                    <Label
                        x:Name="CurrentPageLabel"
                        FontSize="12"
                        Text="Current Page: MainPage"
                        TextColor="#666" />
                </VerticalStackLayout>
            </Border>

            <!--  Log Output  -->
            <Label
                Margin="0,20,0,5"
                FontAttributes="Bold"
                FontSize="18"
                Text="Navigation Log" />

            <Border
                Padding="10"
                BackgroundColor="#1E1E1E"
                HeightRequest="200"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <ScrollView>
                    <Label
                        x:Name="LogLabel"
                        FontFamily="Courier New"
                        FontSize="11"
                        LineBreakMode="WordWrap"
                        Text="Log will appear here..."
                        TextColor="#00FF00" />
                </ScrollView>
            </Border>

            <Button
                BackgroundColor="#333333"
                Clicked="OnClearLogClicked"
                CornerRadius="8"
                HeightRequest="40"
                Text="Clear Log"
                TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
